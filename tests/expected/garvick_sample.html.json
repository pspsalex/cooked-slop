  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Chocolate Frosting:"
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Melt chocolate in double boiler and set aside to cool completely."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Cream together margarine and sugar until light and fluffy. Add eggs, 1 at a time, beating well after each addition. Blend in the vanilla."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Stir together cake flour and salt."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Combine lemon juice and milk."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Blend flour mixture into creamed butter-sugar mixture alternately with lemon juice/milk mixture; mix well."
    },
    {
      "@type": "HowToStep",
      "position": 7,
      "text": "Add melted chocolate, blending thoroughly."
    },
    {
      "@type": "HowToStep",
      "position": 8,
      "text": "Dissolve baking soda in malt vinegar in bowl large enough to accommodate foaming of mixture."
    },
    {
      "@type": "HowToStep",
      "position": 9,
      "text": "Add to batter, mixing well."
    },
    {
      "@type": "HowToStep",
      "position": 10,
      "text": "Divide batter equally between 2 (8\") square cake pans, greased and dusted with cocoa powder."
    },
    {
      "@type": "HowToStep",
      "position": 11,
      "text": "Bake at 350 degrees 30 minutes or until toothpick inserted in center comes out clean."
    },
    {
      "@type": "HowToStep",
      "position": 12,
      "text": "Cool in pans for about 10 minutes, then remove and cool completely on wire racks."
    },
    {
      "@type": "HowToStep",
      "position": 13,
      "text": "Place 1 layer, top-side down, on serving platter."
    },
    {
      "@type": "HowToStep",
      "position": 14,
      "text": "Spoon about 1/3 cup Chocolate Frosting onto layer and spread evenly to edge."
    },
    {
      "@type": "HowToStep",
      "position": 15,
      "text": "Sprinkle with chopped walnuts."
    },
    {
      "@type": "HowToStep",
      "position": 16,
      "text": "Place other layer, top-side up, on frosted layer."
    },
    {
      "@type": "HowToStep",
      "position": 17,
      "text": "Frost sides of cake, then top, covering completely."
    },
    {
      "@type": "HowToStep",
      "position": 18,
      "text": "Chocolate Frosting: Melt chocolate in double boiler and cool completely. Cream together butter and powdered sugar. Add milk, vanilla and melted chocolate. Blend until smooth and creamy."
    }
