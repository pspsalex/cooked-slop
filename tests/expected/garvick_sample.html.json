  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Position rack in center of oven and preheat to 350 degrees F."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Butter 10-inch-diameter springform pan with 2-inch-high sides."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Melt both chocolates with coffee and butter in heavy medium saucepan over medium-low heat, stirring until smooth. Pour into large bowl. Cool. Mix in vanilla extract."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Using electric mixer, beat yolks with both sugars in medium bowl until slowly dissolving ribbon forms when beaters are lifted. Fold yolk mixture into chocolate mixture. Fold in flour."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Using electric mixer fitted with clean, dry beaters, beat whites in another large bowl until almost stiff. Fold 1/4 of whites into chocolate mixture to lighten. Gently fold in remaining whites."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Gently pour batter into prepared pan."
    },
    {
      "@type": "HowToStep",
      "position": 7,
      "text": "Bake until toothpick inserted in center comes out with moist crumbs still attached, about 45 minutes."
    },
    {
      "@type": "HowToStep",
      "position": 8,
      "text": "Transfer to rack and cool (cake will fall)."
    },
    {
      "@type": "HowToStep",
      "position": 9,
      "text": "Cover cake in pan with plastic wrap and let stand. Run small knife around cake pan sides to loosen if needed."
    },
    {
      "@type": "HowToStep",
      "position": 10,
      "text": "Release pan sides of cake. Invert cake onto plate."
    },
    {
      "@type": "HowToStep",
      "position": 11,
      "text": "Place stencil or doily on top of cake. Sift powdered sugar over. Remove stencil and and serve."
    }
  ],
