  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "A simple and delicious banana bread recipe that uses ripe bananas for natural sweetness."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Preheat oven to 350 degrees F. Mix the mashed bananas and melted butter in a large bowl."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Mix in the sugar, beaten egg, and vanilla extract. Sprinkle the baking soda and salt over the mixture and stir to combine."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Add the flour and mix until just combined. Do not overmix."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Pour the batter into a greased 4x8 inch loaf pan. Bake for 60 to 65 minutes, until a toothpick inserted in the center comes out clean."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Let cool in the pan for 10 minutes before removing to a wire rack."
    }
